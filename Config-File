listen: :
tls:
  cert: /root/hfolder/some.crt
  key: /root/hfolder/some.key
  sniGuard: disable
ech:
  keyPath: /root/hfolder/ech.pem
obfs:
  type: gecko
  gecko:
    password: 
    minPacketSize: 512
    maxPacketSize: 1200
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  maxIncomingStreams: 1024
  disablePathMTUDiscovery: false
congestion:
  type: bbr
  bbrProfile: standard
speedTest: false
disableUDP: false
udpIdleTimeout: 60s
auth:
  type: password
  password:
resolver:
  type: https
  https:
    addr: 1.1.1.1:443
    timeout: 10s
    sni: cloudflare-dns.com
    insecure: false
acl:
  inline:
    - reject(all,udp/443)
outbounds:
  - name: direct-out
    type: direct
    direct:
      mode: 4
      fastOpen: true
