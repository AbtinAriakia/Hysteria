listen: :
tls:
  cert: some.crt
  key: some.key
  sniGuard: strict
obfs:
  type: gecko
  gecko:
    password:
    minPacketSize: 512
    maxPacketSize: 1200
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  maxIncomingStreams: 1024
  disablePathMTUDiscovery: false
  disableStatelessReset: false
congestion:
  type: bbr
  bbrProfile: aggressive
speedTest: false
disableUDP: false
udpIdleTimeout: 60s
auth:
  type: password
  password:
outbounds:
  - name: direct
    type: direct
    direct:
      mode: auto
      fastOpen: true
